{
  "name": "s3-stream-demo-server",
  "version": "1.0.0",
  "description": "Express backend: file upload/download to S3, streaming reads, background processing via a queue",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "worker": "node --watch src/queue/worker.js",
    "start": "node src/index.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "multer": "^1.4.5-lts.1",
    "@aws-sdk/client-s3": "^3.632.0",
    "@aws-sdk/lib-storage": "^3.632.0",
    "@aws-sdk/s3-request-presigner": "^3.632.0",
    "bullmq": "^5.12.0",
    "ioredis": "^5.4.1"
  }
}
