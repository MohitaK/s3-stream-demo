# Copy to .env and adjust if needed. Defaults match docker-compose.yml.

PORT=4000

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=uploads
# MinIO needs path-style URLs (bucket.s3.amazonaws.com won't resolve locally).
# Set to false if you point this at real AWS S3.
S3_FORCE_PATH_STYLE=true

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173
