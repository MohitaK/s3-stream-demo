# Copy this file to server/.env and fill in values.
# These match the MinIO container in docker-compose.yml by default.

PORT=4000

# S3 / MinIO config
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=uploads-demo
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Redis / BullMQ config
REDIS_HOST=localhost
REDIS_PORT=6379
